{
  "name": "postext",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:quick": "POSTEXT_QUICK_TESTS=1 turbo run test",
    "test:changed": "TURBO_SCM_BASE=HEAD turbo run test --affected",
    "test:affected": "turbo run test --affected",
    "publish-postext": "pnpm --filter postext publish --access public",
    "cookbook": "pnpm --dir apps/web run cookbook"
  },
  "devDependencies": {
    "turbo": "2.10.12"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.9",
    "mathjax-full": "^3.2.2"
  }
}
