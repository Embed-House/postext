{
  "extends": "@postext/typescript-config/library.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM"
    ],
    "noEmit": true,
    // Bun bundles the CLI: its sources keep extensionless imports.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "..",
    "types": [
      "bun"
    ]
  },
  "include": [
    "src",
    "scripts"
  ],
  "exclude": [
    "node_modules",
    "bin"
  ]
}
